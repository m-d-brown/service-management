// A ready-to-use development environment: open the repo in VS Code (or any
// Dev Containers-compatible editor) and everything `task check`, `task test`
// and `task build` need is installed and configured.
//
// No versions are pinned here or in the Dockerfile. post-create.sh reads them
// from go/go.mod, .python-version and mise.toml — the same files CI reads.
{
  "name": "service-management",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",

  "postCreateCommand": "./.devcontainer/post-create.sh",
  // Don't attach the editor until the toolchain exists, so the Go and Python
  // extensions don't start against a half-provisioned container.
  "waitFor": "postCreateCommand",

  // Claude Code's login and history are the one piece of container state worth
  // keeping; everything else is rebuilt from the repo's version files.
  "mounts": [
    "source=service-management-claude,target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    // Keep the project virtualenv out of the bind-mounted workspace: a .venv
    // built on the host is unusable here (and vice versa), so the two must not
    // share one directory. uv honours this for every workspace member.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },

  "customizations": {
    "vscode": {
      // The extensions behind the checks `task check` runs.
      "extensions": [
        "golang.go",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "DavidAnson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,

        "go.lintTool": "golangci-lint",
        "[go]": { "editor.defaultFormatter": "golang.go" },

        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["python/reboot-orchestrator/tests"],
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },

        // --prose-wrap=always matches the prettier hook in
        // .pre-commit-config.yaml, so saving a file and committing it agree.
        "prettier.proseWrap": "always",
        "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" }
      }
    }
  }
}
